<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFE898" />
      <stop offset="35%" stop-color="#D4AF37" />
      <stop offset="70%" stop-color="#AA820A" />
      <stop offset="100%" stop-color="#7A5A0A" />
    </linearGradient>
    <radialGradient id="maroonBg" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#8B1538" />
      <stop offset="60%" stop-color="#55081E" />
      <stop offset="100%" stop-color="#2A030E" />
    </radialGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#000000" flood-opacity="0.4" />
    </filter>
  </defs>

  <!-- Outer Gold Ring -->
  <circle cx="256" cy="256" r="248" fill="url(#gold)" />
  
  <!-- Inner Maroon Circle -->
  <circle cx="256" cy="256" r="232" fill="url(#maroonBg)" />
  
  <!-- Dotted Inner Accent Ring -->
  <circle cx="256" cy="256" r="216" fill="none" stroke="url(#gold)" stroke-width="4" stroke-dasharray="8 6" opacity="0.6" />
  <circle cx="256" cy="256" r="204" fill="none" stroke="url(#gold)" stroke-width="2" opacity="0.4" />

  <!-- Laurel Leaves (Left) -->
  <g fill="url(#gold)" opacity="0.85">
    <path d="M 110 340 Q 80 240 140 160 Q 120 220 150 290 Z" />
    <path d="M 90 260 Q 70 210 110 170 Z" />
    <path d="M 130 190 Q 120 140 170 120 Z" />
  </g>

  <!-- Laurel Leaves (Right) -->
  <g fill="url(#gold)" opacity="0.85">
    <path d="M 402 340 Q 432 240 372 160 Q 392 220 362 290 Z" />
    <path d="M 422 260 Q 442 210 402 170 Z" />
    <path d="M 382 190 Q 392 140 342 120 Z" />
  </g>

  <!-- Central Pillar of Justice -->
  <rect x="243" y="130" width="26" height="200" rx="6" fill="url(#gold)" filter="url(#shadow)" />
  <rect x="210" y="130" width="92" height="16" rx="4" fill="url(#gold)" />
  <rect x="215" y="318" width="82" height="16" rx="4" fill="url(#gold)" />

  <!-- Scales Horizontal Beam -->
  <path d="M 120 160 H 392" stroke="url(#gold)" stroke-width="14" stroke-linecap="round" filter="url(#shadow)" />
  <circle cx="256" cy="160" r="14" fill="url(#gold)" />

  <!-- Left Scale Pan & Cords -->
  <line x1="130" y1="160" x2="95" y2="235" stroke="url(#gold)" stroke-width="5" />
  <line x1="130" y1="160" x2="165" y2="235" stroke="url(#gold)" stroke-width="5" />
  <path d="M 80 235 C 80 280 180 280 180 235 Z" fill="url(#gold)" filter="url(#shadow)" />

  <!-- Right Scale Pan & Cords -->
  <line x1="382" y1="160" x2="347" y2="235" stroke="url(#gold)" stroke-width="5" />
  <line x1="382" y1="160" x2="417" y2="235" stroke="url(#gold)" stroke-width="5" />
  <path d="M 332 235 C 332 280 432 280 432 235 Z" fill="url(#gold)" filter="url(#shadow)" />

  <!-- RD Monogram Plaque -->
  <rect x="150" y="345" width="212" height="90" rx="16" fill="#6A0C25" stroke="url(#gold)" stroke-width="7" filter="url(#shadow)" />
  <text x="256" y="412" text-anchor="middle" fill="#FFFFFF" font-size="64" font-weight="900" font-family="'Cinzel', Georgia, serif" letter-spacing="8">RD</text>
</svg>
